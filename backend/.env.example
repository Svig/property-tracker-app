# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=4000

# Auth — generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string

# Database client: "mariadb" or "postgres"
DB_CLIENT=mariadb

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=viewing_register
