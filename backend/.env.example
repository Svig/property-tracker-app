# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=4000

# Auth — generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=thisisalongstringtotestapplication

# Database client: "mariadb" or "postgres"
DB_CLIENT=mariadb

DB_HOST=localhost
DB_PORT=3305
DB_USER=viewingapp
DB_PASSWORD=ChangeMe123!
DB_NAME=viewing_register
