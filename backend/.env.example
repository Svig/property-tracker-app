# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=4000

# Auth — generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string

# Database client: "mariadb" or "postgres"
DB_CLIENT=mariadb

# EASIEST OPTION: if your host gives you a single connection string (Aiven,
# Supabase, Neon, Render's own Postgres, etc. all show one), paste the
# whole thing here and leave DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
# blank below — this is parsed automatically, including turning SSL on
# when the URL says ssl-mode=REQUIRED or sslmode=require.
#   mysql://user:password@host:port/dbname?ssl-mode=REQUIRED
#   postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# ALTERNATIVE: set these individually instead of DATABASE_URL. Don't paste
# a full connection string into DB_HOST specifically — if you accidentally
# do, the app will still work (it detects and parses it), but it'll warn
# in the logs every time; use DATABASE_URL above instead.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=viewing_register

# Set to true when pointing at a hosted database (Aiven, Supabase, Neon,
# etc.) — they require SSL. Leave false for a local install.
DB_SSL=false
# Optional: paste the provider's CA certificate here (the full contents,
# BEGIN/END lines included) for a verified connection. If omitted while
# DB_SSL=true, the connection is still encrypted but the server's
# certificate isn't verified — fine for a small internal tool, but use
# the CA when your provider makes one available.
DB_SSL_CA=
